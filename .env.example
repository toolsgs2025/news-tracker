# Supabase — found in Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# OpenRouter — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-...

# Optional: pick a different model. Default is anthropic/claude-haiku-4.5.
# Browse models at https://openrouter.ai/models
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Optional: identify your app to OpenRouter (shown in their dashboard).
# OPENROUTER_REFERER=https://your-domain.com
